{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    // The shadcn/ui primitives under src/components/ui (including Image)
    // are untyped React.forwardRef components, so checkJs floods any page
    // that passes them props with false-positive "property does not exist
    // on IntrinsicAttributes" errors unrelated to real bugs. Next's own
    // build-time TS pass (`next build`) still runs and passes; this script
    // is left for IDE intellisense / module resolution, not a deep JSX
    // prop-shape gate.
    "checkJs": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "types": []
  },
  "include": ["next-env.d.ts", "**/*.js", "**/*.jsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist", "src/components/ui", "src/hooks"]
}
