# Umami analytics (set these in Vercel → Project Settings → Environment Variables,
# never commit real values). See the analytics setup guide for how to get each one.
# Must be prefixed NEXT_PUBLIC_ to be readable in the browser bundle.

# The script URL from your Umami deployment, e.g. https://stats.yourdomain.com/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# The website ID shown in Umami's dashboard for this site
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Comma-separated real domain(s) this site is served from, so Vercel preview
# URLs and localhost are never tracked, e.g. yourdomain.com,www.yourdomain.com
NEXT_PUBLIC_UMAMI_DOMAINS=

# Onboarding form notification email (src/app/api/onboarding/route.js).
# Server-only -- never prefix these with NEXT_PUBLIC_, they must not reach
# the browser bundle.

# Resend API key (resend.com -> API Keys). Required for the onboarding
# form to actually deliver submissions -- without it, submissions are
# rejected rather than silently dropped.
RESEND_API_KEY=

# Where onboarding form submissions are sent.
OWNER_NOTIFICATION_EMAIL=

# Optional. Defaults to Resend's shared test address if unset. Set this
# once a sending domain is verified in Resend (Domains -> Add Domain),
# e.g. "Prestige Estate Management <onboarding@prestigeestatemanagement.com>".
RESEND_FROM_EMAIL=
